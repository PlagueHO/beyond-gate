{
  "manifest_version": 3,
  "name": "Beyond Gate login",
  "version": "0.1.0",
  "description": "Human-controlled Windows login for Beyond Gate.",
  "key": "",
  "permissions": ["cookies", "nativeMessaging"],
  "host_permissions": [
    "https://dndbeyond.com/*",
    "https://www.dndbeyond.com/*"
  ],
  "incognito": "not_allowed",
  "action": { "default_title": "Open Beyond Gate login" },
  "background": { "service_worker": "launch.mjs", "type": "module" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'; base-uri 'none'"
  }
}
