{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}",
    "env": {
      "RUSTDOCFLAGS": "-D warnings"
    }
  },
  "tasks": [
    {
      "label": "Rust: Build debug",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--workspace", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "build", "--workspace", "--locked"]
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Build release",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--release", "--workspace", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "build", "--release", "--workspace", "--locked"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Check formatting",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--all", "--", "--check"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "fmt", "--all", "--", "--check"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Apply formatting",
      "type": "process",
      "command": "cargo",
      "args": ["fmt", "--all"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "fmt", "--all"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Check Clippy",
      "type": "process",
      "command": "cargo",
      "args": ["clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "clippy", "--workspace", "--all-targets", "--locked", "--", "-D", "warnings"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Test workspace",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--workspace", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "test", "--workspace", "--locked"]
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$rustc"
    },
    {
      "label": "CLI: Test process",
      "type": "process",
      "command": "cargo",
      "args": ["test", "-p", "beyond-gate-cli", "--test", "cli", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "test", "-p", "beyond-gate-cli", "--test", "cli", "--locked"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "CLI: Test adapters",
      "type": "process",
      "command": "cargo",
      "args": ["test", "-p", "beyond-gate-cli", "--test", "adapter_process", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "test", "-p", "beyond-gate-cli", "--test", "adapter_process", "--locked"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "MCP: Test process",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/test-mcp.ps1"],
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Test examples",
      "type": "process",
      "command": "cargo",
      "args": ["test", "--workspace", "--doc", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "test", "--workspace", "--doc", "--locked"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Rust: Build API docs",
      "type": "process",
      "command": "cargo",
      "args": ["doc", "--workspace", "--no-deps", "--document-private-items", "--locked"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "doc", "--workspace", "--no-deps", "--document-private-items", "--locked"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "CLI: Help",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--locked", "-p", "beyond-gate-cli", "--", "--help"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "run", "--locked", "-p", "beyond-gate-cli", "--", "--help"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "MCP: Help",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--locked", "-p", "beyond-gate-mcp", "--", "--help"],
      "windows": {
        "command": "pwsh",
        "args": ["-NoProfile", "-File", "${workspaceFolder}\\scripts\\cargo.ps1", "run", "--locked", "-p", "beyond-gate-mcp", "--", "--help"]
      },
      "problemMatcher": "$rustc"
    },
    {
      "label": "Docs: Check Markdown",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check-docs.ps1", "-Mode", "Style"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Check links",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check-docs.ps1", "-Mode", "Links"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Test checker",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/test-doc-checks.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Run site",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "dev"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Build site",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "build"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Test site",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "test"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Preview site",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "preview"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Build themes",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "build:themes"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Preview themes",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "preview:themes"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Validate site",
      "dependsOrder": "sequence",
      "dependsOn": ["Docs: Build site", "Docs: Test site"],
      "problemMatcher": []
    },
    {
      "label": "Workspace: Validate",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/validate-workspace.ps1"],
      "problemMatcher": []
    },
    {
      "label": "CLI: Run",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/run.ps1", "cli"],
      "presentation": { "reveal": "always", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "MCP: Serve stdio",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/run.ps1", "mcp"],
      "presentation": { "reveal": "always", "focus": true },
      "problemMatcher": []
    },
    {
      "label": "Workspace: Fetch dependencies",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/cargo.ps1", "fetch", "--locked"],
      "problemMatcher": []
    },
    {
      "label": "Workspace: Test developer workflow",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/test-developer-workflow.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Install checker",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/install-doc-tools.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Docs: Install site dependencies",
      "type": "process",
      "command": "pnpm",
      "args": ["--dir", "docs", "install", "--frozen-lockfile"],
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Install checker",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/install-dependency-tools.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Check",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check-dependencies.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Check offline",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/check-dependencies.ps1", "-Offline"],
      "problemMatcher": []
    },
    {
      "label": "Dependencies: Test checker",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/test-dependency-checks.ps1"],
      "problemMatcher": []
    },
    {
      "label": "Docker: Build image",
      "type": "process",
      "command": "docker",
      "args": ["build", "--tag", "beyond-gate:local", "."],
      "problemMatcher": []
    },
    {
      "label": "Docker: CLI help",
      "type": "process",
      "command": "docker",
      "args": ["run", "--rm", "--network", "none", "beyond-gate:local", "--help"],
      "problemMatcher": []
    },
    {
      "label": "Docker: MCP help",
      "type": "process",
      "command": "docker",
      "args": ["run", "--rm", "--network", "none", "--entrypoint", "beyond-gate-mcp", "beyond-gate:local", "--help"],
      "problemMatcher": []
    },
    {
      "label": "Docker: Test runtime",
      "type": "process",
      "command": "pwsh",
      "args": ["-NoProfile", "-File", "${workspaceFolder}/scripts/test-runtime-container.ps1"],
      "problemMatcher": []
    }
  ]
}
